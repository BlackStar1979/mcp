{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp://romion/tool-registry.schema.json",
  "title": "ROMION MCP Tool Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "registry_id", "tools"],
  "properties": {
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "registry_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^[A-Za-z]:)|(^/)|(^\\\\)|(^|/)\\.\\.(/|$)" }
    },
    "toolName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{1,127}$"
    },
    "modelRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+-]*$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "enabled",
        "description",
        "runtime",
        "dsl_schema",
        "output_schema",
        "rag",
        "sandbox",
        "limits",
        "policy",
        "observability",
        "rollback"
      ],
      "properties": {
        "tool": { "$ref": "#/$defs/toolName" },
        "enabled": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "base_model", "adapter", "adapter_required"],
          "properties": {
            "provider": { "type": "string", "enum": ["vllm", "local", "external"] },
            "base_model": { "$ref": "#/$defs/modelRef" },
            "adapter": { "type": ["string", "null"], "maxLength": 256 },
            "adapter_required": { "type": "boolean" }
          }
        },
        "dsl_schema": { "$ref": "#/$defs/relativePath" },
        "output_schema": { "$ref": "#/$defs/relativePath" },
        "rag": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index_path", "writable", "top_k", "max_context_chars"],
          "properties": {
            "index_path": { "$ref": "#/$defs/relativePath" },
            "writable": { "type": "boolean" },
            "top_k": { "type": "integer", "minimum": 0, "maximum": 50 },
            "max_context_chars": { "type": "integer", "minimum": 0, "maximum": 200000 }
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "read_write", "project_readonly", "ttl_seconds", "quota_mb", "clean_on_start", "clean_on_finish"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "read_write": { "type": "boolean" },
            "project_readonly": { "type": "boolean" },
            "ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
            "quota_mb": { "type": "integer", "minimum": 10, "maximum": 10240 },
            "clean_on_start": { "type": "boolean" },
            "clean_on_finish": { "type": "boolean" }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_internal_steps", "max_questions_to_dyrygent", "budget_tokens", "timeout_ms"],
          "properties": {
            "max_internal_steps": { "type": "integer", "minimum": 1, "maximum": 5 },
            "max_questions_to_dyrygent": { "type": "integer", "minimum": 0, "maximum": 2 },
            "budget_tokens": { "type": "integer", "minimum": 1000, "maximum": 200000 },
            "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 1800000 }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow_network", "allow_project_write", "requires_dry_run", "requires_validation", "requires_audit", "allowed_operations"],
          "properties": {
            "allow_network": { "type": "boolean" },
            "allow_project_write": { "type": "boolean" },
            "requires_dry_run": { "type": "boolean" },
            "requires_validation": { "type": "boolean" },
            "requires_audit": { "type": "boolean" },
            "allowed_operations": {
              "type": "array",
              "items": { "type": "string", "enum": ["read", "sandbox_write", "rag_read", "rag_write", "plan", "dry_run", "validate", "mcp_apply"] },
              "uniqueItems": true
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trace_level", "ledger_path", "record_inputs", "record_plan", "record_steps", "record_outputs", "record_validation"],
          "properties": {
            "trace_level": { "type": "string", "enum": ["minimal", "standard", "full"] },
            "ledger_path": { "$ref": "#/$defs/relativePath" },
            "record_inputs": { "type": "boolean" },
            "record_plan": { "type": "boolean" },
            "record_steps": { "type": "boolean" },
            "record_outputs": { "type": "boolean" },
            "record_validation": { "type": "boolean" }
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "checkpoint_required"],
          "properties": {
            "strategy": { "type": "string", "enum": ["none", "backup", "patch_inverse", "snapshot"] },
            "checkpoint_required": { "type": "boolean" }
          }
        }
      }
    }
  }
}
